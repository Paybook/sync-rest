		{
			"name": "Get testing sites (institutions)",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"",
							"var jsonData = JSON.parse(responseBody);",
							"tests[\"Got test sites (institutions)\"] = jsonData.code === 200;",
							"",
							"if(tests[\"Got test sites (institutions)\"]){",
							"    var jsonData = JSON.parse(responseBody);",
							"    test_sites = jsonData.response;",
							"    for(var i=0; i<test_sites.length; i++){",
							"        test_site = test_sites[i];",
							"        tests[i + '. ' + test_site.name] = true;",
							"        if(test_site.name == 'Normal'){",
							"            postman.setGlobalVariable(\"sync_id_test_site\", test_site.id_site);",
							"            tests['Got \"Normal\" id_site'] = true;",
							"        }//End of if",
							"    }//End of for",
							"}//End of if",
							"",
							"",
							"",
							"",
							""
						]
					}
				}
