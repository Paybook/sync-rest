		{
			"name": "Get users linked to an API key",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"",
							"var jsonData = JSON.parse(responseBody);",
							"tests[\"Got API key users\"] = jsonData.code === 200;",
							"",
							"if(tests[\"Got API key users\"]){",
							"    var jsonData = JSON.parse(responseBody);",
							"    users = jsonData.response;",
							"    tests[\"Users obtained: \" + users.length] = true;",
							"}//End of if",
							""
						]
					}
				},
				{
					"listen": "prerequest",
					"script": {
						"type": "text/javascript",
						"exec": [
							"",
